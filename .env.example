# Copy to .env for local development (`npm run dev` and the tests load it).

# The worker's own role (never the service-role key). Local: the password is
# set in ../proc-robot-web/supabase/seed.sql. Hosted: the Supavisor pooler, transaction mode:
#   postgresql://procrobot_worker.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://procrobot_worker:worker-local@127.0.0.1:54322/postgres"

# Optional (defaults in src/config.ts)
# WORKER_CONCURRENCY=4
# WORKER_QUEUES=ping
# JOB_MAX_ATTEMPTS=5
# JOB_VISIBILITY_TIMEOUT_SECONDS=60
# JOB_RETRY_BASE_SECONDS=30
# POLL_SECONDS=5
# HEALTH_PORT=3299
# ALERT_WEBHOOK_URL=   # Slack-compatible incoming webhook for dead letters
# LOG_LEVEL=info

# Supabase Storage, for the documents jobs read (T1.3). Local: `npx supabase status`
# in ../proc-robot-web prints the API URL and SECRET_KEY. Storage only — never the database.
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_SECRET_KEY=

# Claude, for document extraction (T1.3). Without a key, extraction jobs fail at once
# (and refund); set EXTRACTION_FAKE=true to read spreadsheets by column name, without AI.
ANTHROPIC_API_KEY=
# EXTRACTION_MODEL=claude-haiku-5-5
# EXTRACTION_REVIEW_MODEL=claude-opus-5-5
# EXTRACTION_FAKE=false
